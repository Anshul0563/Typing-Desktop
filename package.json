{
  "name": "typepath-ssc",
  "version": "1.0.0",
  "description": "SAS Academy typing practice and examination desktop application",
  "author": "SAS Academy",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:desktop": "concurrently -k \"npm run dev --prefix server\" \"npm run dev --prefix client\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "build:desktop": "npm run build --prefix client -- --mode desktop",
    "dist:win": "npm run build:desktop && electron-builder --win nsis portable",
    "dist:win:installer": "npm run build:desktop && electron-builder --win nsis",
    "dist:win:portable": "npm run build:desktop && electron-builder --win portable",
    "test": "npm test --prefix server"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "in.sasacademy.typing",
    "productName": "SAS Academy Typing",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "desktop/assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SAS Academy Typing",
      "artifactName": "SAS-Academy-Typing-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SAS-Academy-Typing-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.61.1",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
